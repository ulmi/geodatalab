{
  "name": "geodatalab",

  // Same compose files as `pixi run start`, plus an idle overlay.
  // The generated fragment holds image, name, workspace and data mounts.
  "initializeCommand": "pixi run render",
  "dockerComposeFile": [
    "../compose.yml",
    "../.gdl/default/compose.data.yml",
    "compose.idle.yml"
  ],
  "service": "gis",
  "workspaceFolder": "/gdl/workspace",
  "shutdownAction": "none",
  "remoteUser": "root",

  "forwardPorts": [8888],
  "portsAttributes": {
    "8888": { "label": "JupyterLab", "onAutoForward": "notify" }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-toolsai.jupyter",
        "ms-toolsai.jupyter-keymap",
        "ms-toolsai.jupyter-renderers"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/venv/bin/python",
        "python.terminal.activateEnvironment": false,
        "terminal.integrated.defaultProfile.linux": "bash",
        "jupyter.kernelSpecFindPaths": ["/venv/share/jupyter/kernels"]
      }
    }
  },

  "postCreateCommand": "echo '── geodatalab ready ──' && python --version && gdalinfo --version"
}
