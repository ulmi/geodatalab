# ============================================================
# geodatalab - GIS Data Laboratory
# Multi-stage build: compile in builder, runtime-only in final
#
# Profiles (ARG PROFILE):
#   kitchen   - Python GIS stack + JupyterLab + whitebox
#   lab       - kitchen + netCDF4/h5py + GRASS GIS + SAGA GIS  [default]
#   institute - lab + R + Julia
#   r+julia   - JupyterLab + R + Julia only (no heavy GIS Python stack)
# ============================================================

# --- Stage 1: Builder ---
FROM debian:trixie-slim AS builder

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        python3 \
        python3-dev \
        python3-pip \
        python3-venv \
        python3-setuptools \
        python3-wheel \
        libgdal-dev \
        libproj-dev \
        libgeos-dev \
        libspatialindex8 \
        libhdf5-310 \
        libhdf5-hl-310 \
        pkg-config \
        curl \
        cmake \
        ninja-build \
        liblaszip-dev \
        libtbb-dev \
    && rm -rf /var/lib/apt/lists/*

# Build PDAL from source (not yet available in Debian Trixie repos).
# TBB is auto-detected by cmake via find_package(TBB) when libtbb-dev is present — no cmake flag needed.
# (-DWITH_TBB=ON is NOT a valid PDAL cmake flag; it causes exit status 6.)
# Installed to /opt/pdal so it's easy to COPY into the runtime stage.
ARG PDAL_VERSION=2.10.2
RUN curl -fsSL \
        "https://github.com/PDAL/PDAL/releases/download/${PDAL_VERSION}/PDAL-${PDAL_VERSION}-src.tar.bz2" \
        -o /tmp/pdal-src.tar.bz2 \
    && tar xf /tmp/pdal-src.tar.bz2 -C /tmp \
    && cmake -S "/tmp/PDAL-${PDAL_VERSION}-src" -B /tmp/pdal-build -GNinja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/opt/pdal \
        -DWITH_LASZIP=ON \
        -DWITH_TESTS=OFF \
        -DBUILD_PLUGIN_PYTHON=OFF \
    && cmake --build /tmp/pdal-build -j$(nproc) \
    && cmake --install /tmp/pdal-build \
    && rm -rf /tmp/pdal-src.tar.bz2 /tmp/pdal-build "/tmp/PDAL-${PDAL_VERSION}-src"

ARG PROFILE=lab
COPY requirements/ /tmp/requirements/
# Locked install: requirements/locks/<profile>.lock pins every package
# (generated by `pixi run lock`). Falls back to the floating .txt files
# when no lock exists yet. pdal + pybind11 come from requirements/build.txt and
# are part of the lock; pdal compiles against /opt/pdal via CMAKE_PREFIX_PATH.
RUN python3 -m venv /venv && \
    /venv/bin/pip install --no-cache-dir --upgrade pip && \
    if [ -f "/tmp/requirements/locks/${PROFILE}.lock" ]; then \
        echo "Installing from lock: ${PROFILE}.lock" && \
        CMAKE_PREFIX_PATH=/opt/pdal /venv/bin/pip install --no-cache-dir \
            -r "/tmp/requirements/locks/${PROFILE}.lock"; \
    else \
        echo "WARNING: no lock for ${PROFILE} — resolving latest versions" && \
        CMAKE_PREFIX_PATH=/opt/pdal /venv/bin/pip install --no-cache-dir \
            -r "/tmp/requirements/${PROFILE}.txt" -r /tmp/requirements/build.txt; \
    fi

# Build pylasr (lasR Python bindings) from source.
# Provides catalog-aware LiDAR processing with OpenMP parallelism and automatic
# spatial-indexed buffer reads — much faster than PDAL for tiled datasets.
# lasR publishes no tags/releases, so it is pinned to a commit SHA for
# reproducibility. Bump deliberately: git ls-remote https://github.com/r-lidar/lasR main
ARG LASR_VERSION=b17d396966acde06f59a0970fb843a318324391a
RUN apt-get update && apt-get install -y --no-install-recommends git && rm -rf /var/lib/apt/lists/*
RUN git init -q /tmp/lasR \
    && git -C /tmp/lasR fetch -q --depth=1 https://github.com/r-lidar/lasR.git "${LASR_VERSION}" \
    && git -C /tmp/lasR checkout -q FETCH_HEAD \
    && CMAKE_PREFIX_PATH="$(/venv/bin/python3 -c 'import pybind11; print(pybind11.get_cmake_dir())')" \
       /venv/bin/pip install --no-cache-dir /tmp/lasR/python \
    && rm -rf /tmp/lasR

# Install latest stable Julia via official installer (juliaup).
# Staged under /opt/juliaup + /opt/julia-depot for the final stage.
RUN mkdir -p /opt/juliaup /opt/julia-depot && \
    case "$PROFILE" in \
        institute|r+julia) \
            curl -fsSL https://install.julialang.org | sh -s -- --yes \
            && cp -a /root/.juliaup/. /opt/juliaup/ \
            && cp -a /root/.julia/juliaup/. /opt/julia-depot/ \
            ;; \
    esac

# --- Stage 2: Runtime ---
FROM debian:trixie-slim

LABEL org.opencontainers.image.title="geodatalab" \
      org.opencontainers.image.description="GIS Data Laboratory" \
      org.opencontainers.image.version="4.0"

ENV DEBIAN_FRONTEND=noninteractive \
    TZ=Etc/UTC \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    PATH=/opt/pdal/bin:/venv/bin:/usr/local/bin:$PATH \
    LD_LIBRARY_PATH=/opt/pdal/lib \
    VIRTUAL_ENV=/venv \
    SAGA_TLB=/usr/lib/saga \
    GDL_ROOT=/gdl \
    GDL_WORKSPACE=/gdl/workspace \
    GDL_DATA=/gdl/data \
    GDL_MODE=lab

# Re-declare ARG so it's available in this stage
ARG PROFILE=lab
ENV GDL_PROFILE=${PROFILE} \
    GDL_BACKEND=container

# Base packages — always installed
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 \
        python3-setuptools \
        ca-certificates \
        git \
        unzip \
        libglib2.0-0 \
        libgomp1 \
        libspatialindex8 \
        libhdf5-310 \
        libhdf5-hl-310 \
        gdal-bin \
        proj-bin \
        libgeos-c1t64 \
        liblaszip8 \
        libtbb12 \
    && rm -rf /var/lib/apt/lists/*

# GRASS GIS + SAGA GIS — lab and institute profiles only
RUN case "$PROFILE" in \
        lab|institute) \
            apt-get update && apt-get install -y --no-install-recommends \
                grass saga python3-saga \
            && rm -rf /var/lib/apt/lists/* \
            ;; \
    esac

# R + IRkernel package — institute and r+julia profiles
RUN case "$PROFILE" in \
        institute|r+julia) \
            apt-get update && apt-get install -y --no-install-recommends \
                r-base r-base-dev \
            && rm -rf /var/lib/apt/lists/* \
            && Rscript -e "install.packages('IRkernel', repos='https://cloud.r-project.org', quiet=TRUE)" \
            ;; \
    esac

COPY --from=builder /venv /venv
COPY --from=builder /opt/pdal /opt/pdal
COPY --from=builder /opt/juliaup /root/.juliaup
COPY --from=builder /opt/julia-depot /root/.julia/juliaup

ENV PATH="/root/.juliaup/bin:${PATH}"

# Targeted bridge for the apt-installed GIS Python APIs (SAGA, GRASS).
# PEP 668: we never pip-install into system Python — everything lives in /venv,
# which is built from the same /usr/bin/python3 so the C-extension ABI matches.
# Instead of exposing ALL of /usr/lib/python3/dist-packages (which would let old
# apt packages silently shadow missing venv packages), only expose:
#   /opt/gis-python/PySAGA  -> SAGA Python API (symlink)
#   GRASS's own python dir  -> from `grass --config python_path`
# The build fails here if either API is not importable.
RUN case "$PROFILE" in \
        lab|institute) \
            set -e; \
            SITE=$(/venv/bin/python -c 'import sysconfig; print(sysconfig.get_paths()["purelib"])'); \
            mkdir -p /opt/gis-python; \
            ln -s "$(dirname "$(dpkg -L python3-saga | grep '/PySAGA/__init__.py$')")" /opt/gis-python/PySAGA; \
            { echo /opt/gis-python; grass --config python_path; } > "$SITE/gis-bridge.pth"; \
            cat "$SITE/gis-bridge.pth"; \
            cd /tmp; \
            /venv/bin/python -c "from PySAGA import saga_api as s; print(s.SAGA_API_Get_Version()); s.SG_Initialize_Environment(True, True); n = s.SG_Get_Tool_Library_Manager().Get_Count(); print('SAGA tool libraries:', n); assert n > 0"; \
            /venv/bin/python -c "import grass.script as gs; print('grass.script OK:', gs.__file__)" \
            ;; \
    esac \
    && /venv/bin/python -m pip check

# Kernel specs — needs Jupyter (from venv) and Julia to be present
RUN case "$PROFILE" in \
        institute|r+julia) \
            PATH=/venv/bin:$PATH Rscript -e "IRkernel::installspec(user=FALSE)" \
            ;; \
    esac

RUN if [ -f /root/.juliaup/bin/julia ]; then \
        PATH=/venv/bin:$PATH julia -e \
            'using Pkg; Pkg.add("IJulia"); using IJulia'; \
    fi

COPY entrypoint.sh /entrypoint.sh
COPY tests/smoke.py /opt/geodatalab/smoke.py
RUN chmod +x /entrypoint.sh

# Uniform workbench layout (same on every backend):
#   /gdl/workspace   the workspace (read-write)
#   /gdl/data/<name> declared data folders (geodatalab.toml)
# /workspace and /data are kept as symlinks for backward compatibility
# (notebooks using /workspace/... or /data/<name>/... keep working).
RUN mkdir -p /gdl/workspace /gdl/data \
    && ln -s /gdl/workspace /workspace \
    && ln -s /gdl/data /data

WORKDIR /gdl/workspace
EXPOSE 8888

HEALTHCHECK --interval=30s --timeout=5s --retries=3 --start-period=15s \
    CMD [ "${GDL_MODE:-lab}" = "idle" ] || python3 -c "import socket; socket.create_connection(('localhost', 8888), 2).close()"

CMD ["/entrypoint.sh"]
